# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.
JWT_SECRET=change-me-to-a-long-random-string

# Default test account (seeded automatically on first run)
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234

# Optional: override file-db location (Vercel uses /tmp automatically)
# TASKADY_DB_PATH=.data/db.json

# Shared Postgres (Neon free tier) — set in Vercel to fix data across
# serverless instances. When set, the Prisma backend replaces the file-db.
# Use the pooled connection for DATABASE_URL and the direct one for DIRECT_URL.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.neon.tech/taskady?sslmode=require
# DIRECT_URL=postgresql://user:password@ep-xxx.neon.tech/taskady?sslmode=require
